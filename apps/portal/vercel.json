{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "sveltekit",
      "installCommand": "bun install",
      "buildCommand": "bun run typecheck && bun run build"
    },
    "eve": {
      "root": ".",
      "framework": "eve",
      "installCommand": "bun install",
      "buildCommand": "eve build"
    }
  },
  "rewrites": [
    {
      "source": "/eve/v1/(.*)",
      "destination": { "service": "eve" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
